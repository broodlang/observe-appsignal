;; observe-appsignal — AppSignal as an `observe` provider: logs, metrics and errors over
;; AppSignal's public HTTP endpoints. The batching, buffering and the request worker are
;; `observe`'s; this package is the three wire formats.
(project
  :name "observe-appsignal"
  :version "0.2.1"
  :brood ">= 0.47.0"
  :description
    "AppSignal as an `observe` provider — logs, metrics and errors over AppSignal's public endpoints."
  :repository "https://github.com/broodlang/observe-appsignal"
  :dependencies [[observe :version "^0.2.1"]])
